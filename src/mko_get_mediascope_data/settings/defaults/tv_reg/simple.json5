{
  // Set default parameters for data export from the media scope
  "DATA_DEFAULTS": {
    "date_filter": null,  // Filter is specified as a list ('Start', 'End'). Multiple periods can be specified
    "weekday_filter": null,  // Set weekdays
    "daytype_filter": null,  // Set day type
    "company_filter": null,  // Set channels
    "location_filter": null,  // Set viewing location
    "basedemo_filter": null,  // Set target audience
    "targetdemo_filter": null, // Additional target audience filter, only needed when calculating the ratio between audiences, e.g. when calculating Affinity Index
    "program_filter": null,  // Program filter
    "break_filter": null,  // Break filter
    "ad_filter": null,  // Ad filter:
    "sortings": null,  // Set sorting conditions:
    "slices": null,  // Specify list of slices
    "statistics": null,  // Specify list of statistics for calculation

    "options": {
      // dataset id (1-Russia all, 2-Russia 100+, 3-Cities, 4-TVI+ Russia all, 5-TVI+ Russia 100+, 6-Moscow)
      // Only one value can be specified
      "kitId": 3, //TV Index Russia Reg
      "issueType": "AD",  // Event type for Cross-tab (Crosstab) report: PROGRAM, BREAKS, AD
      "standRtg": {
        "useRealDuration": false,  // Calculated based on actual ad duration.
        "standardDuration": 20  // Standard duration of 20 seconds
      }
    },
    "add_city_to_basedemo_from_region": true,  // Required for region calculation
    "add_city_to_targetdemo_from_region": true, // Required for region calculation
    "frequency_dist_conditions": null, // Sets frequency distribution
  }
}
