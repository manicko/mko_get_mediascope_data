[
  {
    "report_type": "crosstab",
    "report_subtype": "DYNAMICS_BY_SPOTS",
    "media": "TV",
    "compression": {
      "method": "gzip",
    },
    "data_lang": "ru",
    "relative_path": "finance/raw_data",
    "multiple_files": true,
    "ad_filter": "articleLevel2Id = 2272 and adIssueStatusId = R",
    "target_audiences": {
      "all 18+": "age >= 18",
      "all 20-45 BC": "age >= 20 AND age <= 45 AND incomeGroupRussia IN (2,3)",
      "all 20-45": "age >= 25 AND age <= 55",
      "w 25-55": "sex = 2 AND age >= 25 AND age <= 55",
    },
    "period": {
      "date_filter": [
        "2021-01-01",
        "2024-11-30",
      ],
      "time_unit": "m",
    },
  },
]
